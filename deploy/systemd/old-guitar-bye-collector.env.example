# Optional overrides for old-guitar-bye-collector.service.
# The unit already contains these safe defaults.
DATABASE_PATH=/home/ubuntu/old-guitar-bye/data/guitar.db
BUNJANG_SEARCH_KEYWORDS=기타,통기타,어쿠스틱 기타
BUNJANG_RESULTS_PER_KEYWORD=20
BUNJANG_ENRICH_DETAILS=false
OPPORTUNITY_LOOKBACK_DAYS=30
OPPORTUNITY_THRESHOLD_PCT=12
